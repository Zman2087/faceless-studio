      "link": null,
      "locked": false,
      "text": "No site repo attached? The Showrunner puts\nstate.json in its log for you to commit.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No site repo attached? The Showrunner puts\nstate.json in its log for you to commit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ahC35FXxDaJAjyGcz5rrz",
      "type": "text",
      "x": 40,
      "y": 930,
      "width": 888.591796875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1453663424,
      "version": 2,
      "versionNonce": 1814641856,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792739145032,
      "link": null,
      "locked": false,
      "text": "You connect Stripe yourself; Claude never sees or stores a secret key and never charges, refunds or edits anything in Stripe.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You connect Stripe yourself; Claude never sees or stores a secret key and never charges, refunds or edits anything in Stripe.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_7YR_YRFn3CMPmHNg1c05",
      "type": "text",
      "x": 40,
      "y": 960,
      "width": 1078.1982421875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 758941504,
      "version": 2,
      "versionNonce": 866512704,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792739145032,
      "link": null,
      "locked": false,
      "text": "state.json holds only what viewers may see: the open vote and live shares, past parts, the case board, the next drop. Never meters, the map or endings.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "state.json holds only what viewers may see: the open vote and live shares, past parts, the case board, the next drop. Never meters, the map or endings.",
      "autoResize": true,
      "lineHeight": 1.25
    },
